# ==============================================================================
# unieee — Environment Configuration Template
# Copy to .env for local overrides (DO NOT commit .env to Git)
# ==============================================================================

# Edge / Reverse Proxy (unprivileged ports >= 1024 for rootless Podman)
UNIEEE_HTTP_PORT=8080
UNIEEE_HTTPS_PORT=8443

# PostgreSQL (Source of Truth)
POSTGRES_DB=unieee
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_USER=unieee
POSTGRES_PASSWORD=unieee_dev_password

# PgBouncer (Transaction Pooling)
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_MAX_DB_CONNECTIONS=80

# Redis HA (Master-Replica + Sentinel)
REDIS_PASSWORD=unieee_redis_dev_password

# Keycloak (OIDC / OAuth 2.0 / JWT)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# Apache Kafka (KRaft Mode)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
