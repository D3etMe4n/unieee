# ==============================================================================
# unieee — Environment Configuration Template
# Copy to .env for local overrides (DO NOT commit .env to Git)
# ==============================================================================

# Edge / Reverse Proxy / TLS Mode
# Supported UNIEEE_TLS_MODE:
#   - custom      : Use UNIEEE_TLS_CERT_FILE/KEY_FILE, or auto-generate self-signed cert
#   - letsencrypt : Auto-issue & renew Let's Encrypt cert via ACME HTTP-01 (requires public domain + ports 80/443)
#   - cloudflared : Expose via Cloudflare Tunnel (Quick Tunnel or Named Tunnel with custom domain)
UNIEEE_TLS_MODE=custom
UNIEEE_DOMAIN=localhost
UNIEEE_HTTP_PORT=8080
UNIEEE_HTTPS_PORT=8443

# Custom TLS certificate paths (optional, used when UNIEEE_TLS_MODE=custom)
UNIEEE_TLS_CERT_FILE=
UNIEEE_TLS_KEY_FILE=

# Let's Encrypt settings (used when UNIEEE_TLS_MODE=letsencrypt)
UNIEEE_LETSENCRYPT_EMAIL=
UNIEEE_LETSENCRYPT_STAGING=true

# Cloudflare Tunnel token (optional, used when UNIEEE_TLS_MODE=cloudflared)
# Leave empty for Quick Tunnel (*.trycloudflare.com); set token for Named Tunnel with custom domain
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL (Source of Truth)
POSTGRES_DB=unieee
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_USER=unieee
POSTGRES_PASSWORD=unieee_dev_password

# PgBouncer (Transaction Pooling)
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_MAX_DB_CONNECTIONS=80

# Redis HA (Master-Replica + Sentinel)
REDIS_PASSWORD=unieee_redis_dev_password

# Keycloak (OIDC / OAuth 2.0 / JWT)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# Apache Kafka (KRaft Mode)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
